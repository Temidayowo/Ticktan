# Neon Postgres — use the pooled connection string (hostname contains "-pooler")
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/ticktan?sslmode=require"

# Auth.js (NextAuth v5) — generate with: npx auth secret
AUTH_SECRET=""

# Cloudflare R2 (S3-compatible object storage for uploaded images)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="ticktan-uploads"
R2_PUBLIC_URL="https://pub-xxxxxxxxxxxx.r2.dev"

# Resend (contact form confirmation emails)
RESEND_API_KEY=""
# Optional — defaults to onboarding@resend.dev until a sending domain is verified
# RESEND_FROM_EMAIL="Ticktan <hello@ticktan.com>"
